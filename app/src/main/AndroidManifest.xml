<?xml version="1.0" encoding="utf-8"?>
<!--
  internalOnly: on TVs that use a USB drive as storage, apps there load after boot, and Android
  drops their accessibility services (Haven's Home button) because they look missing. Internal
  storage loads first, so the Home button survives restarts.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Read the TV's Watch Next list and app channels (granted at install; protection level normal) -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Runtime permission; without it the TV hides other apps' rows. Granted once over ADB. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Private DNS switch. Not grantable from the UI; granted once over ADB. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Wallpapers (Bing, Earth View, Wikimedia, Unsplash). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Backup file in Download/Haven that survives reinstalls. Granted once over ADB (appops). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Reads whether Private DNS is verified or a VPN is overriding it (status line). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi page in Quick settings: network name, signal and nearby networks. Android only
         shows Wi-Fi names to apps with location access (asked once with Android's own popup). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Bluetooth section of TV controls: paired devices and which are connected (asked once). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Cleanup: Scan and Privacy list every installed package, including ones that are switched off. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Lets "Keep enforced" restore Private DNS after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the launcher see every app that has a TV or phone launcher entry -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- What this TV offers (This TV): its own home screen, display settings and Sony's apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <package android:name="com.sony.dtv.configsettings" />
        <package android:name="com.sony.dtv.settingsdisplay" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_haven"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haven">

        <!-- Haven's sleep timer: powers the TV off when it runs out. -->
        <receiver android:name=".data.SleepTimerReceiver" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets Android use Haven for the Home button. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.aktvhome.launcher.action.OPEN_SEARCH" />
                <action android:name="com.aktvhome.launcher.action.OPEN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SearchShortcutActivity"
            android:exported="true"
            android:label="@string/haven_search"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsShortcutActivity"
            android:exported="true"
            android:label="@string/haven_settings"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".HomeOverrideService"
            android:exported="false"
            android:label="@string/home_override_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_override" />
        </service>

        <!-- Only so NBA alerts can see what's playing (media sessions). Granted once over ADB. -->
        <service
            android:name=".HavenMediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
